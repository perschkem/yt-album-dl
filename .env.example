# Zielordner – Windows-Pfade (D:\...) werden unter WSL automatisch zu /mnt/d/... umgewandelt
MUSIK_DIR=D:\Musik
PODCAST_DIR=D:\Podcasts

# Audioformat: mp3 (läuft überall) oder m4a (ohne Umkodieren, schneller, keine Qualitätsverluste)
AUDIO_FORMAT=mp3

# MP3-Bitrate in kbit/s (bei m4a nur relevant, wenn umkodiert werden muss)
BITRATE=320

# Gleichzeitige Downloads / gleichzeitige Schnitte beim Album-Aufteilen (Standard: Anzahl CPU-Kerne)
PARALLEL_DOWNLOADS=3
# PARALLEL_CUTS=4

# Wiederholungen bei vorübergehenden Fehlern (exponentieller Backoff: 2 s, 4 s, 8 s … max. 2 Min.)
MAX_RETRIES=5

# Webserver
HOST=127.0.0.1
PORT=8000

# Optional: Ordner mit ffmpeg/ffprobe, falls nicht im PATH
# FFMPEG_LOCATION=/opt/ffmpeg/bin

# Optional: Ordner für Download-Archiv (verhindert doppelte Downloads)
# DATA_DIR=./data
